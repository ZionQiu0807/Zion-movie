# 本地配置（含 PushPlus token）——绝不能提交
config.local.json

# 本地推送日志（只把推送记录入库，用于云端去重，防止定时任务补跑重复推送）
logs/*
!logs/推送记录.jsonl

# 扫描页渲染图（约 300MB）与核对中间产物
book_images/
_render_test/

# verify/：只保留核对与扩充的结果文件，其余（工作单、候选、渲染图）不入库
verify/*
!verify/核对结果_批次*.json
!verify/扩充结果_批次*.json
!verify/README.md

# Python
__pycache__/
*.pyc
.venv/

# 系统
.DS_Store
Thumbs.db
